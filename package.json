{
  "name": "ctrlb-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "electron:dev": "concurrently -n vite,electron -c green,blue \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "ai.ctrlb.app",
    "productName": "ctrlb.ai",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "remotion/**/*",
      "server/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@remotion/compositor-*/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.60.0",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.484",
    "@remotion/player": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.484",
    "zod": "^4.4.3"
  }
}
