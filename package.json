{
  "name": "ctrlb",
  "version": "0.3.2",
  "description": "Cursor for video editing - AI-powered video editor with minimal interface",
  "author": "sparky0520",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/schema.test.js test/apply-operations.test.js test/proposals.test.js",
    "test:contracts": "node --test test/operations.test.js test/ai-response.test.js test/ai-planner.test.cjs",
    "test:render-smoke": "node --test test/build.test.js test/render-timing.test.js test/packaged-workflow.test.js && node scripts/render-mp4-smoke.cjs",
    "test:ai-evals": "node --test test/ai-evaluations.test.js",
    "fixtures:prepare": "node scripts/prepare-representative-fixtures.cjs",
    "benchmark:render": "node scripts/benchmark-render.cjs",
    "verify:production": "node scripts/verify-production-build.cjs dist release/win-unpacked",
    "verify:ci": "npm run test:unit && npm run test:contracts && npm run test:render-smoke && npm test && npm run build && npm run verify:production",
    "build": "vite build",
    "build:icon": "electron scripts/build-electron-icon.cjs",
    "dev": "vite",
    "preview": "vite preview",
    "electron:dev": "concurrently -n vite,electron -c green,blue \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "ai.ctrlb.app",
    "productName": "ctrlb",
    "icon": "public/ctrlb-mark.png",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ctrlb-mark.png",
      "remotion/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "sparky0520",
      "repo": "ctrlb"
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@remotion/bundler": "^4.0.484",
    "@remotion/player": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "@vitejs/plugin-react": "^5.2.0",
    "assemblyai": "^4.35.4",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.484",
    "zod": "^4.4.3"
  }
}
