# Copy to .env.local. Never commit real values.
PORT=8787
NODE_ENV=development

# Legacy v1 planner compatibility only.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k3
CTRLB_DESKTOP_AI_PROVIDER=kimi

# Transcription
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=

# Authentication and request policy
CTRLB_CLERK_PUBLISHABLE_KEY=
CTRLB_AUTH_AUDIENCE=
CTRLB_AUTH_AUTHORIZED_PARTIES=
CTRLB_AUTH_DEFAULT_SCOPES=plan:create transcribe:create derivatives:create
CTRLB_RATE_LIMIT_PER_MINUTE=120

# Durable database
SUPABASE_DB_URL=
# New request-shaped video agent. Legacy planner keys remain separate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
