# Copy to .env.local. Never commit real values.
CTRLB_BACKEND_URL=https://ctrlb-backend.onrender.com
CTRLB_AUDIO_CATALOG_URL=
CTRLB_CLERK_PUBLISHABLE_KEY=

# Development bootstrap auth only; keep false for normal signed-in flows.
CTRLB_ALLOW_BOOTSTRAP_AUTH=false
CTRLB_PLANNER_CLIENT_TOKEN=

# Release signing. Leave empty for debug builds.
CTRLB_ANDROID_UPLOAD_STORE_FILE=
CTRLB_ANDROID_UPLOAD_STORE_PASSWORD=
CTRLB_ANDROID_UPLOAD_KEY_ALIAS=
CTRLB_ANDROID_UPLOAD_KEY_PASSWORD=
