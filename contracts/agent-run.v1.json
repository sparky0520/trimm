{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrlb.ai/contracts/agent-run.v1.json",
  "title": "ctrlB agent run v1",
  "type": "object",
  "required": ["contractVersion", "runId", "projectId", "projectRevision", "status", "events", "decision"],
  "properties": {
    "contractVersion": { "const": 1 },
    "runId": { "type": "string" },
    "projectId": { "type": "string" },
    "projectRevision": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["waiting_for_evidence", "waiting_for_user", "proposal_ready", "partial", "failed", "cancelled"] },
    "events": {
      "type": "array",
      "items": { "$ref": "activity-event.v1.json" }
    },
    "decision": {
      "oneOf": [
        { "$ref": "evidence-request.v1.json" },
        { "$ref": "edit-program.v1.json" },
        {
          "type": "object",
          "required": ["type", "question", "options"],
          "properties": {
            "type": { "const": "clarification" },
            "question": { "type": "string", "minLength": 1, "maxLength": 500 },
            "options": { "type": "array", "maxItems": 5, "items": {} }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "reason"],
          "properties": {
            "type": { "const": "fallback" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
