{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrlb.ai/contracts/evidence-request.v1.json",
  "title": "ctrlB evidence request v1",
  "type": "object",
  "required": ["type", "jobs"],
  "properties": {
    "type": { "const": "evidence_request" },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "type",
          "purpose",
          "acceptedFormat",
          "range",
          "maximumBytes",
          "maximumDurationMs",
          "expiresAt",
          "reused"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "enum": ["audio", "frame", "crop", "text", "evidence"] },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 100 },
          "acceptedFormat": { "type": "string", "minLength": 1, "maxLength": 100 },
          "range": {
            "type": "object",
            "required": ["startMs", "endMs"],
            "properties": {
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "maximumBytes": { "type": "integer", "minimum": 1 },
          "maximumDurationMs": { "type": ["integer", "null"], "minimum": 1 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "reused": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
