{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrlb.ai/contracts/edit-program.v1.json",
  "title": "ctrlB edit program v1",
  "type": "object",
  "required": ["type", "expectedRevision", "summary", "operations"],
  "properties": {
    "type": { "const": "edit_program" },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string", "maxLength": 2000 },
    "operations": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/editOperation" }
    }
  },
  "$defs": {
    "editOperation": {
      "type": "object",
      "required": ["id", "type", "enabled", "confidence", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": {
          "enum": [
            "remove_fumbles",
            "set_audio_cleanup",
            "set_audio_levels",
            "add_sound_effect",
            "set_background_music",
            "add_captions",
            "semantic_visual"
          ]
        },
        "enabled": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeRange" }
        },
        "range": { "$ref": "#/$defs/timeRange" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "speechDecision": { "$ref": "#/$defs/speechDecision" },
        "intent": { "enum": ["INTRODUCE", "POINT_OUT", "TRANSITION", "REVEAL", "EMPHASIZE", "RECAP"] },
        "treatment": { "enum": ["CALLOUT", "SPOTLIGHT", "REFRAME"] },
        "subject": { "$ref": "#/$defs/subject" },
        "framing": { "$ref": "#/$defs/framing" }
      },
      "additionalProperties": true,
      "not": {
        "anyOf": [
          { "required": ["command"] },
          { "required": ["shell"] },
          { "required": ["executable"] },
          { "required": ["sourceUri"] },
          { "required": ["renderedOutput"] }
        ]
      }
    },
    "speechDecision": {
      "type": "object",
      "required": ["meaningPreserved", "completeDeliverySelected", "rationale", "contextEvidenceIds", "locatorSignals", "contextSignals", "transcriptUncertain", "uncertaintyAction", "technicalTieBreakerOnly"],
      "properties": {
        "meaningPreserved": { "const": true },
        "completeDeliverySelected": { "const": true },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "contextEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "locatorSignals": { "type": "array", "uniqueItems": true, "items": { "enum": ["possible_filler", "pause_candidate", "repeated_phrase", "transcript_uncertainty", "delivery_discontinuity"] } },
        "contextSignals": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "enum": ["surrounding_context", "speaker_scene_cadence", "word_phoneme_timing", "user_intent", "alternate_takes", "waveform_scene_noise", "surrounding_video", "proposal_simulation"] } },
        "transcriptUncertain": { "type": "boolean" },
        "uncertaintyAction": { "enum": ["none", "re_listened", "alternate_transcription", "escalated"] },
        "technicalTieBreakerOnly": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "timeRange": {
      "type": "object",
      "required": ["startMs", "endMs"],
      "properties": {
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "right": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["evidenceId", "kind", "bounds", "confidence"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["FACE", "SCREEN_UI", "PRODUCT", "OCR_TEXT", "SALIENCE"] },
        "bounds": { "$ref": "#/$defs/bounds" },
        "confidence": { "type": "number", "minimum": 0.55, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "framing": {
      "type": "object",
      "required": ["zoom", "preservesSubject", "preservesText"],
      "properties": {
        "zoom": { "type": "number", "minimum": 1 },
        "preservesSubject": { "const": true },
        "preservesText": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
