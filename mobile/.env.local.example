# Copy to .env.local. Never commit real values.
TRIMM_BACKEND_URL=https://trimm-backend.onrender.com
TRIMM_AUDIO_CATALOG_URL=
TRIMM_CLERK_PUBLISHABLE_KEY=

# Development bootstrap auth only; keep false for normal signed-in flows.
TRIMM_ALLOW_BOOTSTRAP_AUTH=false
TRIMM_PLANNER_CLIENT_TOKEN=

# Release signing. Leave empty for debug builds.
TRIMM_ANDROID_UPLOAD_STORE_FILE=
TRIMM_ANDROID_UPLOAD_STORE_PASSWORD=
TRIMM_ANDROID_UPLOAD_KEY_ALIAS=
TRIMM_ANDROID_UPLOAD_KEY_PASSWORD=
