# Copy to .env.local. Never commit real values.
PORT=8787
NODE_ENV=development

# Agent Decision & AI Agent Provider (OpenAI Compatible)
LLM_API_KEY=
LLM_OPENAI_BASE_URL=https://api.moonshot.ai/v1
MODEL=kimi-k3

# Transcription
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-2

# AI Audio Generation
REPLICATE_API_TOKEN=
ELEVENLABS_API_TOKEN=

# Durable database & Caching
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SFX_S3_BUCKET=trimm-sfx-cache

# Authentication and request policy
TRIMM_CLERK_PUBLISHABLE_KEY=
TRIMM_AUTH_AUDIENCE=
TRIMM_AUTH_AUTHORIZED_PARTIES=
TRIMM_AUTH_DEFAULT_SCOPES=plan:create transcribe:create derivatives:create
TRIMM_RATE_LIMIT_PER_MINUTE=120
TRIMM_PLANNER_CLIENT_TOKEN=
TRIMM_ALLOW_BOOTSTRAP_AUTH=true
