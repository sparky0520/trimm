{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimm.ai/contracts/activity-event.v2.json",
  "type": "object",
  "required": ["sequence", "type", "message", "createdAt"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["started", "transcript_received", "analyzing", "evidence_requested", "evidence_received", "proposal_repairing", "proposal_repaired", "proposal_repair_failed", "clarification", "proposal_ready", "partial", "failed", "cancelled"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" }
  }, "additionalProperties": false
}
